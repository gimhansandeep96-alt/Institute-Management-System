            <TableColumn fx:id="pricetbl" prefWidth="169.59996337890624" text="Price" />
        </columns>
      </TableView>
      <Button fx:id="savebtn" layoutX="48.0" layoutY="407.0" mnemonicParsing="false" onAction="#savebtnOnAction" style="-fx-background-color: #3498db;" text="Save" textFill="#131212" />
      <Button fx:id="updatebtn" layoutX="113.0" layoutY="407.0" mnemonicParsing="false" onAction="#updatebtnOnAction" style="-fx-background-color: #27ae60;" text="Update" />
      <Button fx:id="deletebtn" layoutX="195.0" layoutY="407.0" mnemonicParsing="false" onAction="#deletebtnOnAction" style="-fx-background-color: #e74c3c;" text="Delete" />
      <Button fx:id="clearbtn" layoutX="268.0" layoutY="407.0" mnemonicParsing="false" onAction="#clearbtnOnAction" style="-fx-background-color: #95a5a6;" text="Clear" />
   </children>
</AnchorPane>
