<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="484.0" prefWidth="796.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.institute1.controller.courseController">
   <children>
      <Label layoutX="14.0" layoutY="16.0" prefHeight="42.0" prefWidth="254.0" text="Course Management ">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label layoutX="42.0" layoutY="90.0" text="Course ID" />
      <TextField fx:id="txtid" layoutX="43.0" layoutY="127.0" prefHeight="26.0" prefWidth="194.0" promptText="01" />
      <TextField fx:id="txtname" layoutX="43.0" layoutY="205.0" prefHeight="26.0" prefWidth="194.0" promptText="CMJD" />
      <TextField fx:id="txtprice" layoutX="42.0" layoutY="342.0" prefHeight="26.0" prefWidth="194.0" promptText="6500.00" />
      <TextField fx:id="txtduration" layoutX="43.0" layoutY="271.0" prefHeight="26.0" prefWidth="194.0" promptText="6 Months" />
      <Label layoutX="42.0" layoutY="253.0" text="Course Duration" />
      <Label layoutX="42.0" layoutY="177.0" text="Course Name" />
      <Label layoutX="42.0" layoutY="325.0" text="Course Price" />
      <TableView fx:id="coursetable" layoutX="277.0" layoutY="54.0" prefHeight="326.0" prefWidth="499.0">
